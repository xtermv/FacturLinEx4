  end;

  P.Tag := ABtn.ComponentIndex;
  P.TabOrder := AOrden;
  P.Visible := ABtn.Visible;
  P.Enabled := ABtn.Enabled;
  if P.Enabled then P.Color := clWhite
  else P.Color := RGBToColor(241, 243, 244);
