function TFMenu.ColorTextoParaFondo(AColor: TColor): TColor;
var
  C: LongInt;
  R, G, B: Integer;
begin
  C := ColorToRGB(AColor);
  R := C and $FF;
  G := (C shr 8) and $FF;
  B := (C shr 16) and $FF;
  if ((R * 299) + (G * 587) + (B * 114)) > 155000 then
    Result := RGBToColor(30, 41, 59)
  else
    Result := clWhite;
end;

