function TFMenu.PanelTarjetaDesdeSender(Sender: TObject): TPanel;
var
  C: TControl;
begin
  Result := nil;
  if not (Sender is TControl) then Exit;
  C := TControl(Sender);
  while C <> nil do
  begin
    if (C is TPanel) and (Pos('FLXTile_', C.Name) = 1) then
    begin
      Result := TPanel(C);
      Exit;
    end;
    C := C.Parent;
  end;
